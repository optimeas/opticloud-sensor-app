    "Saved as “%@”, on the device %@, with the time and, if location is allowed, the position." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird als „%1$@“ auf dem Gerät %2$@ gespeichert, mit der Zeit und, wenn Ortung erlaubt ist, der Position."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrée sous « %1$@ » sur l’appareil %2$@, avec l’heure et, si la localisation est autorisée, la position."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvata come «%1$@» sul dispositivo %2$@, con l’ora e, se la localizzazione è consentita, la posizione."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda como «%1$@» en el dispositivo %2$@, con la hora y, si la ubicación está permitida, la posición."
          }
        }
      }
    },
