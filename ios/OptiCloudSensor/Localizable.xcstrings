        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves se escriben en lowerCamelCase, por ejemplo «testValue». La telemetría pasa por la cola sin conexión; un atributo de cliente necesita una conexión."
