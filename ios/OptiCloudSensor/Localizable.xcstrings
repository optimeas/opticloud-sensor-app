    "“%@” is bound to another phone. If you take it over, the other phone stops sending to this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist an ein anderes Telefon gebunden. Wenn du es übernimmst, sendet das andere Telefon nicht mehr an dieses Gerät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est lié à un autre téléphone. Si vous le reprenez, l’autre téléphone cesse d’envoyer vers cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» è associato a un altro telefono. Se lo prendi in carico, l’altro telefono smette di inviare a questo dispositivo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» está vinculado a otro teléfono. Si lo tomas, el otro teléfono deja de enviar a este dispositivo."
          }
        }
      }
    },
