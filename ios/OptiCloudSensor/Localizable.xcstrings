    "A note in seconds, with a tap or with Siri. Without a network, it waits and is sent later." : {
      "comment" : "Highlight of version 0.8",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Notiz in Sekunden, mit einem Tipp oder mit Siri. Ohne Netz wartet sie und wird später gesendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une note en quelques secondes, d’un toucher ou avec Siri. Sans réseau, elle attend et part plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nota in pochi secondi, con un tocco o con Siri. Senza rete aspetta e viene inviata più tardi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nota en segundos, con un toque o con Siri. Sin red, espera y se envía más tarde."
          }
        }
      }
    },
    "A sensor that needs a permission asks for it when transmission starts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Sensor, der eine Erlaubnis braucht, fragt danach, sobald das Senden startet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un capteur qui nécessite une autorisation la demande au démarrage de l’envoi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sensore che richiede un’autorizzazione la chiede quando inizia l’invio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sensor que necesita un permiso lo pide cuando empieza el envío."
          }
        }
      }
    },
