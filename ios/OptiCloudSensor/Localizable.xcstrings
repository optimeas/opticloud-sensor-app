    "The app no longer stops when the connection drops while data arrives." : {
      "comment" : "Change in version 0.8",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App bricht nicht mehr ab, wenn die Verbindung abreißt, während Daten ankommen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app ne s’arrête plus quand la connexion tombe pendant la réception de données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app non si interrompe più quando la connessione cade mentre arrivano dati."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app ya no se detiene cuando se corta la conexión mientras llegan datos."
          }
        }
      }
    },
    "The app no longer stops when the mobile network drops, for example on a train." : {
      "comment" : "Highlight of version 0.8",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App bricht nicht mehr ab, wenn das Mobilfunknetz wegfällt, zum Beispiel im Zug."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app ne s’arrête plus quand le réseau mobile tombe, par exemple dans le train."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app non si interrompe più quando cade la rete mobile, per esempio in treno."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app ya no se detiene cuando se cae la red móvil, por ejemplo en el tren."
          }
        }
      }
    },
    "The app sends only what you choose, to the device you choose. Its code is open source." : {
      "comment" : "Feature on the welcome screen",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App sendet nur, was du wählst, an das Gerät, das du wählst. Ihr Code ist Open Source."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app n’envoie que ce que vous choisissez, à l’appareil que vous choisissez. Son code est open source."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app invia solo ciò che scegli, al dispositivo che scegli. Il suo codice è open source."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app solo envía lo que eliges, al dispositivo que eliges. Su código es abierto."
          }
        }
      }
    },
