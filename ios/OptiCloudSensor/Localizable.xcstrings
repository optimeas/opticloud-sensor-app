    "An estimate: the app counts what it sends and receives, and adds an allowance for encryption and the network protocols. Your carrier may count differently." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Schätzung: Die App zählt, was sie sendet und empfängt, und rechnet einen Zuschlag für Verschlüsselung und Netzwerkprotokolle hinzu. Dein Mobilfunkanbieter zählt möglicherweise anders."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une estimation : l’app compte ce qu’elle envoie et reçoit, et ajoute une marge pour le chiffrement et les protocoles réseau. Votre opérateur peut compter différemment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una stima: l’app conta ciò che invia e riceve e aggiunge una quota per la crittografia e i protocolli di rete. Il tuo operatore potrebbe contare in modo diverso."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una estimación: la app cuenta lo que envía y recibe, y añade un margen para el cifrado y los protocolos de red. Tu operador puede contar de otra forma."
          }
        }
      }
    },
    "Another phone has taken over this device. Choose the device again to take it back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein anderes Telefon hat dieses Gerät übernommen. Wähle das Gerät erneut aus, um es zurückzuholen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un autre téléphone a repris cet appareil. Choisissez de nouveau l’appareil pour le récupérer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un altro telefono ha preso in carico questo dispositivo. Scegli di nuovo il dispositivo per riprenderlo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otro teléfono ha tomado este dispositivo. Vuelve a elegir el dispositivo para recuperarlo."
          }
        }
      }
    },
