            "value" : "Schnellnotiz aus der Live-Ansicht. Der Titel ist freiwillig; ohne ihn nimmt die Notiz die erste Zeile des Texts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note rapide depuis la vue en direct. Le titre est facultatif ; sans titre, la note prend la première ligne du texte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
