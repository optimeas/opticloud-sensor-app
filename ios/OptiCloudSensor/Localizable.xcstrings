    "%lld samples have not been delivered yet. They are discarded when you pick another device." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld sample has not been delivered yet. It is discarded when you pick another device."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld samples have not been delivered yet. They are discarded when you pick another device."
                }
              }
            }
          }
        },
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Probe wurde noch nicht zugestellt. Sie wird verworfen, wenn du ein anderes Gerät wählst."
